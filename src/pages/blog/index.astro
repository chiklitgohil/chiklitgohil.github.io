---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ContactFooter from "@components/ContactFooter.astro";
import Icon from "@components/Icon.astro";
import SectionIntro from "@components/SectionIntro.astro";
import TagList from "@components/TagList.astro";
import { formatDate } from "../../utils/date";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Blog" description="Markdown-powered writing by Chiklit Gohil.">
  <main class="pt-16">
    <SectionIntro
      title="Blog"
      eyebrow="Writing"
      description="Notes on projects, computer science, AI experiments, and the lessons that come from building things."
    />
    <div class="grid gap-4">
      {
        posts.map((post) => (
          <a class="group rounded-xl border border-zinc-700/60 bg-zinc-800/70 p-4 transition-colors hover:border-yellow-300/70 sm:p-5" href={`/blog/${post.id}/`}>
            <div class="flex items-start justify-between gap-5">
              <div>
                <time class="text-sm text-yellow-300" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                <h2 class="mt-2 text-xl font-semibold text-white">{post.data.title}</h2>
                <p class="mt-2 text-sm leading-6 text-zinc-300 sm:text-base sm:leading-7">{post.data.description}</p>
              </div>
              <Icon name="arrow-right" class="mt-1 h-4 w-4 shrink-0 text-zinc-500 transition-all group-hover:translate-x-0.5 group-hover:text-yellow-300" />
            </div>
            <TagList tags={post.data.tags} />
          </a>
        ))
      }
    </div>
  </main>
  <ContactFooter />
</BaseLayout>
