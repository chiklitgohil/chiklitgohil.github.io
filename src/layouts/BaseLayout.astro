---
import type { ImageMetadata } from "astro";
import { Font, getImage } from "astro:assets";
import Header from "@components/Header.astro";
import { site } from "@data/site";
import profileImage from "../assets/profile.jpg";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  /** Preview image for social shares. Defaults to the profile photo. */
  image?: ImageMetadata;
  type?: "website" | "article";
  publishedTime?: Date;
}

const {
  title = site.title,
  description = site.description,
  wide = false,
  image,
  type = "website",
  publishedTime,
} = Astro.props;
const pageTitle = title === site.title ? title : `${title} | ${site.title}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// JPEG for social cards: not every scraper accepts WebP.
const socialImage = await getImage({
  src: image ?? profileImage,
  width: image ? 1200 : 400,
  format: "jpg",
});
const socialImageUrl = new URL(socialImage.src, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} | Blog`} href={new URL("rss.xml", Astro.site)} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(socialImage.attributes.width)} />
    <meta property="og:image:height" content={String(socialImage.attributes.height)} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:site" content="@chiklitgohil" />

    <Font cssVariable="--font-inter" preload={[{ subset: "latin", style: "normal" }]} />
  </head>
  <body>
    <div class={wide ? "mx-auto w-full px-4 pb-20 pt-0 sm:px-8" : "mx-auto max-w-[760px] px-4 pb-20 pt-0 sm:px-12 md:px-16"}>
      <Header />
      <slot />
    </div>
  </body>
</html>
